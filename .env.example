# FreightFlow environment configuration (Schema Spec §7.1)
# Copy this file to `.env` and fill in the real values week by week as you
# deploy each AWS service.  Variables are grouped by the week you first need them.

# === Week 1: Django Basics ===

# Set to True for local development; must be False when deployed to AWS
DEBUG=True

# Long random string Django uses to sign cookies and tokens — keep it secret
SECRET_KEY=django-insecure-change-me-in-production

# Database connection string.
# Defaults to SQLite for local dev; replace with your RDS URL in Week 4:
#   postgresql://user:password@your-rds-endpoint.rds.amazonaws.com:5432/freightflow
DATABASE_URL=sqlite:///db.sqlite3

# === Week 2: AWS Region ===

# AWS region where you create all your services (e.g. us-east-1, us-west-2)
# Every boto3 client in the app reads this value
AWS_REGION=us-east-1

# === Week 3: S3 (Proof-of-Delivery Images) ===

# Name of the S3 bucket that stores proof-of-delivery photos
# Leave blank (or keep the placeholder) to fall back to local file storage during dev
AWS_STORAGE_BUCKET_NAME=your-pod-images-bucket-name-here

# === Week 4: Telemetry Ingest (API Gateway → Lambda) ===

# Full HTTPS URL of the API Gateway endpoint that fronts the telemetry-ingest Lambda
# The `simulate_sensors` management command POSTs GPS/temperature readings here
TELEMETRY_INGEST_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod/ingest

# Shared secret key sent in the X-API-Key header so the Lambda can reject bad requests
# Use the same value you set on the telemetry-ingest Lambda's own environment variable
TELEMETRY_API_KEY=REPLACE_ME

# === Week 5: SNS (Shipment Status Notifications) ===

# ARN of the SNS topic that Django publishes to whenever a shipment status changes
# Format: arn:aws:sns:<region>:<account-id>:<topic-name>
# Leave blank to silently skip publishing (safe for local dev)
SNS_STATUS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:your-status-topic-name

# === Week 6: Athena (Historical Analytics) ===

# Name of the Athena workgroup to run queries in (usually "primary" unless you created a custom one)
ATHENA_WORKGROUP=primary

# S3 path where Athena writes query results — must end with a trailing slash
ATHENA_OUTPUT_LOCATION=s3://your-athena-results-bucket/athena-results/

# Glue Data Catalog database name that contains the historical shipments table
ATHENA_DATABASE=freightflow_analytics

# === Week 7: Amazon Bedrock (AI Assistant) ===

# Model ID of the Bedrock foundation model used by the AI assistant view
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# AWS region where Bedrock is enabled for your account
# (Bedrock is not available in every region — check the AWS console)
BEDROCK_REGION=us-east-1

# === Week 9: Kinesis (Real-Time Telemetry Stream) ===

# Name of the Kinesis Data Stream that the `simulate_sensors_kinesis` command writes to
KINESIS_STREAM_NAME=your-kinesis-stream-name-here

# =============================================================================
# IMPORTANT REMINDERS FOR STUDENTS
# =============================================================================
#
# 1. NEVER commit your filled-in .env file to Git.
#    It contains secrets.  The .gitignore already excludes `.env` — keep it that way.
#
# 2. Lambda environment variables are NOT stored here.
#    Each Lambda function (telemetry_ingest, status_notify, carrier_webhook,
#    kinesis_telemetry_consumer) has its own environment configuration set
#    directly on the Lambda in AWS.  See Schema Spec §7.2 for the full list
#    of variables each Lambda needs.
#
# 3. The mock carrier script does NOT use environment variables.
#    `mock-carrier-webhook.py` takes its webhook URL and API key as command-line
#    arguments (--webhook-url and --api-key).  See Schema Spec §7.3 for details.
# =============================================================================
